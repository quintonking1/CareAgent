OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=careagent.db

# Set to 1 to keep demo state across server restarts (default: reseed a clean demo on start)
# DEMO_PERSIST=1

# Password for the whole site (HTTP Basic Auth; any username). Required when deployed on Vercel —
# without it the deployed site refuses all requests. Leave unset locally to skip the prompt.
# DEMO_PASSWORD=choose-a-long-password
